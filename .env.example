# Połączenie z MongoDB (replica set: wymagany do transakcji).
# Bez tej zmiennej w trybie dev uruchamia się baza w pamięci (mongodb-memory-server).
MONGODB_URI=
MONGODB_DB=kino

# Czas ważności rezerwacji. Produkcja: 900 s (15 min). Testy: 120 s (2 min).
RESERVATION_TTL_SECONDS=900

# Limit żądań (token bucket na IP) dla operacji zapisu.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=40
RATE_LIMIT_REFILL_PER_SEC=2

# Symulacja zawodnego dostawcy maili (0..1) i jego opóźnienia.
MAILER_FAILURE_RATE=0.15
MAILER_LATENCY_MS=400

# Worker kolejki w procesie serwera (instrumentation.ts).
WORKER_ENABLED=true
# Sekret dla /api/cron/worker (Vercel Cron wysyła go w nagłówku Authorization).
CRON_SECRET=

# --- Etap II: płatności Stripe (WYŁĄCZNIE tryb testowy) ---
# Klucz sekretny sk_test_... (klucz "live" wyłącza płatności zamiast pobrać pieniądze).
STRIPE_SECRET_KEY=
# Sekret endpointu webhooka whsec_...: lokalnie z `stripe listen`, na Vercelu z panelu Stripe.
STRIPE_WEBHOOK_SECRET=
# Adres sklepu dla stron powrotu ze Stripe'a. Na Vercelu można pominąć (brany z VERCEL_*).
APP_URL=http://localhost:3000
# Etap I: zakup bez płatności przez POST /purchase. Tylko do testów kryteriów etapu I.
LEGACY_PURCHASE_WITHOUT_PAYMENT=false

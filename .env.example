# Połączenie z MongoDB (replica set: wymagany do transakcji).
# Bez tej zmiennej w trybie dev uruchamia się baza w pamięci (mongodb-memory-server).
MONGODB_URI=
MONGODB_DB=kino

# Czas ważności rezerwacji. Produkcja: 900 s (15 min). Testy: 120 s (2 min).
RESERVATION_TTL_SECONDS=900

# Limit żądań (token bucket na IP) dla operacji zapisu.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SEC=1

# Symulacja zawodnego dostawcy maili (0..1) i jego opóźnienia.
MAILER_FAILURE_RATE=0.15
MAILER_LATENCY_MS=400

# Worker kolejki w procesie serwera (instrumentation.ts).
WORKER_ENABLED=true
# Sekret dla /api/cron/worker (Vercel Cron wysyła go w nagłówku Authorization).
CRON_SECRET=

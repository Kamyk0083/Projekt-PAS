# Połączenie z MongoDB (replica set: wymagany do transakcji).
# Bez tej zmiennej w trybie dev uruchamia się baza w pamięci (mongodb-memory-server).
MONGODB_URI=
MONGODB_DB=kino

# Czas ważności rezerwacji. Produkcja: 900 s (15 min). Testy: 120 s (2 min).
RESERVATION_TTL_SECONDS=900

# Limit żądań (token bucket na IP) dla operacji zapisu.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=40
RATE_LIMIT_REFILL_PER_SEC=2

# Symulacja zawodnego dostawcy maili (0..1) i jego opóźnienia (tryb simulated).
MAILER_FAILURE_RATE=0.15
MAILER_LATENCY_MS=400

# Worker kolejki w procesie serwera (instrumentation.ts).
WORKER_ENABLED=true
# Sekret dla /api/cron/worker (Vercel Cron wysyła go w nagłówku Authorization).
CRON_SECRET=

# --- Etap II: płatności Stripe (WYŁĄCZNIE tryb testowy) ---
# Klucz sekretny sk_test_... (klucz "live" wyłącza płatności zamiast pobrać pieniądze).
STRIPE_SECRET_KEY=
# Sekret endpointu webhooka whsec_...: lokalnie z `stripe listen`, na Vercelu z panelu Stripe.
STRIPE_WEBHOOK_SECRET=
# Adres sklepu dla stron powrotu ze Stripe'a. Na Vercelu można pominąć (brany z VERCEL_*).
APP_URL=http://localhost:3000
# Etap I: zakup bez płatności przez POST /purchase. Tylko do testów kryteriów etapu I.
LEGACY_PURCHASE_WITHOUT_PAYMENT=false

# --- Etap III: poczta (Resend, WYŁĄCZNIE tryb testowy) ---
# Klucz API re_... Bez niego działa dostawca symulowany (nic nie wychodzi na świat).
RESEND_API_KEY=
# Nadawca. Bez własnej domeny tylko onboarding@resend.dev, a maile dochodzą wyłącznie
# na adres właściciela konta i na adresy testowe (delivered@resend.dev, bounced@resend.dev,
# z dowolną etykietą po "+", np. delivered+jan@resend.dev).
MAIL_FROM=Kino Pasaż <onboarding@resend.dev>
# Wymuszenie dostawcy: resend albo simulated (domyślnie resend, gdy jest klucz).
MAIL_PROVIDER=
MAIL_TIMEOUT_MS=8000

# --- Etap III: punkty (Voucherify, projekt Sandbox) ---
# Z panelu: Project settings > General > Application keys.
VOUCHERIFY_APP_ID=
VOUCHERIFY_SECRET_KEY=
# ID albo nazwa kampanii lojalnościowej (np. camp_... albo "Kino Pasaz Punkty").
VOUCHERIFY_CAMPAIGN_ID=
# Klaster konta: https://api.voucherify.io, https://eu1.api.voucherify.io, https://as1.api.voucherify.io
VOUCHERIFY_API_URL=https://api.voucherify.io
VOUCHERIFY_TIMEOUT_MS=6000
# Sandbox przyjmuje 100 wywołań na godzinę: nasz budżet z zapasem (token bucket w bazie).
VOUCHERIFY_BUDGET_PER_HOUR=80
# Jak długo podpowiadamy saldo z cache'a (nasze operacje odświeżają je od razu).
LOYALTY_CACHE_TTL_SECONDS=45
# Wymuszenie dostawcy punktów: voucherify albo simulated (domyślnie voucherify, gdy są klucze).
LOYALTY_PROVIDER=

# --- Etap IV: lista oczekujących ---
# Sekret webhooka Resenda whsec_... (panel Resend > Webhooks, endpoint https://<adres>/api/webhooks/resend,
# zdarzenia email.bounced i email.delivered). Bez niego o odbitym mailu dowiemy się dopiero po czasie oferty.
RESEND_WEBHOOK_SECRET=
# Najwięcej aktywnych wpisów na liście jednego seansu.
WAITLIST_MAX_PER_EVENT=300
